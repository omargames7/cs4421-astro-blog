---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

const post = (await getCollection('blog')).find((entry) => entry.id === Astro.params.slug);
if (!post) {
	Astro.response.status = 404;
}

const author = post
	? (await getCollection('authors')).find(
			(entry) => entry.id === post.data.author || entry.data.name === post.data.author,
		)
	: undefined;
if (post && !author) {
	throw new Error(`Author profile not found: ${post.data.author}`);
}

const postData = post
	? (({ author: _author, ...data }) => data)(post.data)
	: undefined;
const { Content } = post ? await render(post) : { Content: undefined };
---

{
	post && author && Content && postData ? (
		<BlogPost {...postData} author={author.data}>
			<Content />
		</BlogPost>
	) : (
		<main>
			<h1>Page not found</h1>
			<p>The requested blog post could not be found.</p>
		</main>
	)
}
