---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { PROJECTS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.intro {
				max-width: 680px;
				margin: 0 auto 4rem;
				text-align: center;
			}
			.eyebrow {
				margin: 0 0 0.75rem;
				color: rgb(var(--gray));
				font-size: 0.85rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}
			.intro h1 {
				margin-bottom: 1rem;
				font-size: clamp(2.5rem, 8vw, 4.5rem);
				letter-spacing: -0.05em;
			}
			.intro p:last-child {
				margin: 0;
				font-size: 1.15rem;
			}
			.project-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
				gap: 1.5rem;
			}
			.projects-heading {
				margin-bottom: 1.5rem;
			}
			.project-card {
				overflow: hidden;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 18px;
				background: white;
				box-shadow: 0 12px 40px rgba(var(--black), 8%);
			}
			.project-card a {
				display: block;
				height: 100%;
				color: inherit;
				text-decoration: none;
			}
			.project-card a:hover h3 {
				color: var(--accent);
			}
			.project-cover {
				display: block;
				width: 100%;
				aspect-ratio: 315 / 250;
				border-bottom: 1px solid rgb(var(--gray-light));
				object-fit: cover;
			}
			.project-info {
				padding: 1.5rem;
			}
			.project-info h3 {
				margin-bottom: 0.75rem;
			}
			.project-info p {
				margin: 0;
			}
			@media (max-width: 720px) {
				.intro {
					margin-bottom: 3rem;
				}
				.project-info {
					padding: 1.25rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro" aria-labelledby="intro-heading">
				<p class="eyebrow">Games and projects</p>
				<h1 id="intro-heading">Hi, I’m Omar.</h1>
				<p>I make games and other projects. Explore some of my work below.</p>
			</section>
			<section id="projects" aria-labelledby="projects-heading">
				<h2 class="projects-heading" id="projects-heading">Projects</h2>
				<div class="project-grid">
					{PROJECTS.map((project) => (
						<article class="project-card">
							<a href={project.websiteUrl ?? `/projects/${project.slug}/`}>
								<img class="project-cover" src={project.coverImage} alt={`${project.name} cover art`} />
								<div class="project-info">
									<h3>{project.name}</h3>
									<p>{project.description}</p>
								</div>
							</a>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
