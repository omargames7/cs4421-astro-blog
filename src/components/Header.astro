---
import HeaderLink from './HeaderLink.astro';
import { GITHUB_URL, ITCH_URL, PROJECTS, SITE_TITLE } from '../consts';
---

<header>
	<nav aria-label="Main navigation">
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<div class="project-links">
			<HeaderLink href="/">Home</HeaderLink>
			{PROJECTS.map((project) => (
				<HeaderLink href={`/projects/${project.slug}/`}>{project.name}</HeaderLink>
			))}
		</div>
		<div class="profile-links">
			<a href={ITCH_URL} target="_blank" rel="noreferrer" aria-label="Visit my itch.io profile">
				<img src="/icons/itch.svg" alt="" width="32" height="32" />
			</a>
			<a href={GITHUB_URL} target="_blank" rel="noreferrer" aria-label="Visit my GitHub profile">
				<img src="/icons/github.svg" alt="" width="32" height="32" />
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}
	.site-title {
		color: var(--black);
		font-size: 1rem;
		font-weight: 700;
		text-decoration: none;
	}
	.project-links,
	.profile-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.project-links {
		flex-wrap: wrap;
		justify-content: center;
	}
	.project-links a {
		padding: 0.8em 0.45em;
		color: var(--black);
		text-decoration: none;
	}
	nav a.active {
		font-weight: 700;
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-underline-offset: 0.3em;
	}
	.profile-links a {
		display: flex;
		padding: 0.25rem;
	}
	.profile-links img {
		display: block;
		width: 28px;
		height: 28px;
	}
	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
			justify-content: center;
			padding: 0.75rem 0;
		}
		.site-title {
			width: 100%;
			text-align: center;
		}
	}
</style>
