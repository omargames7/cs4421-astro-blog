---
import { GITHUB_URL, ITCH_URL } from '../consts';

const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Omar.</p>
	<nav aria-label="Social media links">
		<a href={ITCH_URL} target="_blank" rel="noreferrer" aria-label="Visit my itch.io profile">
			<img src="/icons/itch.svg" alt="" width="32" height="32" />
		</a>
		<a href={GITHUB_URL} target="_blank" rel="noreferrer" aria-label="Visit my GitHub profile">
			<img src="/icons/github.svg" alt="" width="32" height="32" />
		</a>
	</nav>
</footer>

<style>
	footer {
		padding: 1.5em 1em 3em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer p {
		margin: 0;
	}
	nav {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-top: 0.5rem;
	}
	nav a {
		display: flex;
		padding: 0.25rem;
		color: rgb(var(--gray-dark));
	}
	nav img {
		display: block;
		width: 28px;
		height: 28px;
	}
</style>
